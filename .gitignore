# --- HøringsSonar spesifikke filer ---
# horingssonar_cache.json COMMITTES bevisst av workflowen (ikke ignorert her) -
# den holder styr på hvilke URL-er som er sett før, slik at rapportene ikke
# fylles med de samme høringene uke etter uke.
*.db
lovsonar_cache*.json
lovsonar_v*.db

# --- Sikkerhet ---
# Svært viktig: Vi må aldri laste opp miljøvariabler med passord (EMAIL_PASS osv.)
.env

# --- Python ---
# Bytecode og kompilerte filer (trengs ikke på GitHub)
__pycache__/
*.py[cod]
*$py.class

# --- Virtuelle miljøer ---
# Disse inneholder lokale kopier av biblioteker (aiohttp, requests osv.)
venv/
.venv/
env/
build/
dist/

# --- OS-spesifikke filer ---
# Filer som lages av Windows eller macOS i mapper
.DS_Store
Thumbs.db

# --- Loggfiler ---
*.log
